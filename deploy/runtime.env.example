# Copy to /opt/mkwealth/runtime.env on the VPS, then chmod 600 runtime.env.
# Generate TOOLS_ACCESS_SECRET with: openssl rand -hex 32
TOOLS_ACCESS_SECRET=
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Use a sender on your verified Resend domain.
LEAD_FROM_EMAIL='Morgan Kaiser <leads@your-verified-domain.com>'

# Assumes an HTTPS reverse proxy running directly on the VPS.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# NEXT_PUBLIC_* belongs in GitHub Actions repository variables, not here.
