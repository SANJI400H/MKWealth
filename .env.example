# Copy to `.env.local` and fill real values before launch.

# Canonical domain (use .com). Point .ae at this host via redirect at DNS/hosting layer.
NEXT_PUBLIC_SITE_URL=https://www.morgankaiser.com

# WhatsApp — digits only, country code first (no +, no spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=971585300329

# Google Appointment Schedule (Strategy Session CTAs)
# Env key kept as CALENDLY_URL for backwards compatibility.
NEXT_PUBLIC_CALENDLY_URL=https://calendar.google.com/appointments/schedules/AcZssZ0vtVHhOcyykoym8P1KW-rviUeV_rLkzpQqcYkVSSE_VyYK3Pa1B1i6SeN_dzaFQ4Q8qw0YDInL

NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Social profiles (footer + schema)
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/_morgankaiser_/
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/morgan-kaiser-0701902b7
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@_morgankaiser_
