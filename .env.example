# Lead form email (Resend). Put real values only in `.env.local` — never commit keys.
# Until a custom domain is verified in Resend, use: LEAD_FROM_EMAIL=Morgan Kaiser <onboarding@resend.dev>
# LEAD_NOTIFY_EMAIL=you@gmail.com
# RESEND_API_KEY=re_xxxxxxxx
# LEAD_FROM_EMAIL=Morgan Kaiser <onboarding@resend.dev>

# Supabase (leads database). Server writes with service role — never expose SERVICE_ROLE to the browser.
# Create a project → SQL Editor → run supabase/migrations/20260914_create_leads.sql
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Signed cookie unlock for Tools + Guide (Name / WhatsApp / email gate). Generate a long random string.
TOOLS_ACCESS_SECRET=generate-a-long-random-string

# Elevated Private Desk cookie (falls back to TOOLS_ACCESS_SECRET if unset).
DESK_ACCESS_SECRET=generate-another-long-random-string

# Secret key for approving desk access: GET /api/desk/grant?email=client@example.com&key=THIS
DESK_GRANT_SECRET=generate-a-grant-admin-secret

# Hosted Client Portal / Private Desk (Private Wealth Dashboard)
NEXT_PUBLIC_CLIENT_PORTAL_URL=https://ml-private-wealth.tiiny.site

# Investor Guide subdomain (private community). When set, main site /guide redirects here.
# Point DNS guide.yourdomain.com → same Next deploy. Example:
# NEXT_PUBLIC_GUIDE_URL=https://guide.morgankaiser.com

# Guide access (videos/PDFs). Separate from calculator Tools cookie.
GUIDE_ACCESS_SECRET=generate-a-guide-access-secret
# Morgan approve/reject: GET /api/guide/grant?email=&key=&action=approve|reject
GUIDE_GRANT_SECRET=generate-a-guide-grant-secret
# Set true to unlock immediately after qualification (still emails Morgan). Default: manual approve.
GUIDE_AUTO_APPROVE=false

# Social video strip (homepage). Free APIs — server-only secrets.
# YouTube works via public RSS without a key; API key enables cleaner most-viewed ranking.
# YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCzJ8G2TDN5wn5MN7hxsg5hg
# Instagram Graph (Creator/Business linked to a Facebook Page). Until set, curated reels in content/social-videos.ts.
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_USER_ID=
